# ─────────────────────────────────────────────────────────────────────────────
# Репозиторий содержит ТОЛЬКО КОД И МЕТОДИКУ.
# Данные каталога живут в Notion и на диске, в git им не место (решение 24.10.2026).
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
.eggs/
.ruff_cache/
.pytest_cache/

# Результаты прогонов и выгрузки каталога
output/
data/
_archive/
*.log
checkpoint.json
state.json

# Входные материалы: сканы описей, карточки, сохранённые страницы.
# ⚠️ Сканы описей — материалы архивов, их перепубликация требует согласования.
input_*/
скрины архивов/
*.jpg
*.jpeg
*.png
*.pdf
*.djvu

# Выгрузки данных. Исключение ниже — журналы решений: это методика, а не данные.
*.csv
*.jsonl
*.html
*.htm

# ⬇️ ЧТО ВСЁ-ТАКИ ХРАНИМ, вопреки правилам выше
# Журналы решений с мотивировкой: воспроизвести прогоном их НЕЛЬЗЯ, в отличие от
# самих выгрузок. Это принятые с экспертом решения о том, что входит в охват проекта.
!reference_sets/scope_decisions_journals/
!reference_sets/scope_decisions_journals/**

# Конфигурация гейта и схема полей каталога — часть кода, не данные
!scripts/modules/filter_keywords.json
!scripts/modules/notion_schema.json
!config/
!config/**

# Временные и битые файлы
*.tmp
*.bak
*.bak_pre_*
*.fix
*.orig
*~

# Конфликтные копии облачной синхронизации
*копия с компьютера*
*Конфликтующая копия*
*конфликтная_копия*

# Секреты — никогда
.env
.env.*
!.env.example
*token*.txt
*.key
*.pem
